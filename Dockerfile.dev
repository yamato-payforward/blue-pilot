# 開発用 Dockerfile
# 本番用の Dockerfile (Rails 標準生成 / Kamal デプロイ用) とは別に、
# docker compose でのローカル開発向けに全 gem (development, test 含む) をインストールする。
ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# gem のビルドや PostgreSQL クライアントに必要なパッケージ
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      libyaml-dev \
      libvips \
      pkg-config \
      postgresql-client \
      curl && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

# development / test を含めて全 gem をインストール
ENV BUNDLE_PATH="/usr/local/bundle"

RUN gem install bundler

# Gemfile を先にコピーして bundle install (レイヤーキャッシュを効かせる)
COPY Gemfile Gemfile.lock ./
RUN bundle install

# アプリ本体をコピー (compose では volume マウントで上書きされる)
COPY . .

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0"]
